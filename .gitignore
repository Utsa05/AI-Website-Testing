# Secrets / local configuration — never commit API keys or local env files.
.env
.env.*
*.key
secrets.json

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/

# Generated at runtime — screenshots and reports produced by test runs.
# The directory structure itself (.gitkeep) is kept; its contents are not.
reports/artifacts/*
!reports/artifacts/.gitkeep

# OS / editor noise
.DS_Store
*.swp
.idea/
.vscode/
